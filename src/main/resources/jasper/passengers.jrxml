<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="TopPassengersReport"
              pageWidth="595" pageHeight="842" columnWidth="515"
              leftMargin="40" rightMargin="40" topMargin="50" bottomMargin="50"
              uuid="7c3a35f6-a3f3-465c-923e-e4f0d8e8b9b4">

    <field name="name" class="java.lang.String"/>
    <field name="nationality" class="java.lang.String"/>
    <field name="flightCount" class="java.lang.Integer"/>

    <sortField name="flightCount" order="Descending"/>
    <title>
        <band height="50">
            <staticText>
                <reportElement x="0" y="10" width="515" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[Pasajeros con más vuelos realizados]]></text>
            </staticText>
        </band>
    </title>

    <columnHeader>
        <band height="25">
            <staticText>
                <reportElement x="0" y="0" width="200" height="25" backcolor="#CCCCCC" mode="Opaque"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Nombre]]></text>
            </staticText>

            <staticText>
                <reportElement x="200" y="0" width="200" height="25" backcolor="#CCCCCC" mode="Opaque"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Nacionalidad]]></text>
            </staticText>

            <staticText>
                <reportElement x="400" y="0" width="115" height="25" backcolor="#CCCCCC" mode="Opaque"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[# de Vuelos]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="200" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{name}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="200" y="0" width="200" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{nationality}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="400" y="0" width="115" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{flightCount}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
</jasperReport>
