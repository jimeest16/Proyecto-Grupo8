<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="flight_occupancy_report" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="9a204037-34ca-4434-8483-1a657ec044d1">

    <!-- Campos de la clase Flight -->
    <field name="number" class="java.lang.Integer"/>
    <field name="route" class="java.lang.String"/>
    <field name="capacity" class="java.lang.Integer"/>
    <field name="occupancy" class="java.lang.Integer"/>
    <field name="porcentajeOccupancy" class="java.lang.Double"/>

    <!-- Variable para promedio -->
    <variable name="TotalOcupacion" class="java.lang.Double" calculation="Sum">
        <variableExpression><![CDATA[$F{porcentajeOccupancy}]]></variableExpression>
    </variable>

    <variable name="PromedioOcupacion" class="java.lang.Double" calculation="Nothing">
        <variableExpression><![CDATA[$V{TotalOcupacion} / $V{REPORT_COUNT}]]></variableExpression>
    </variable>

    <!-- Título -->
    <title>
        <band height="50">
            <staticText>
                <reportElement x="0" y="10" width="555" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[Porcentaje de Ocupación Promedio por Vuelo]]></text>
            </staticText>
        </band>
    </title>

    <!-- Encabezado de columnas -->
    <columnHeader>
        <band height="25">
            <textField>
                <reportElement x="0" y="0" width="70" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA["Vuelo"]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="70" y="0" width="130" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA["Ruta"]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="200" y="0" width="75" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA["Capacidad"]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="275" y="0" width="75" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA["Ocupación"]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="350" y="0" width="150" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA["% Ocupación"]]></textFieldExpression>
            </textField>
        </band>
    </columnHeader>

    <!-- Detalle de cada vuelo -->
    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="70" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{number}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="70" y="0" width="130" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{route}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="200" y="0" width="75" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{capacity}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="275" y="0" width="75" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{occupancy}]]></textFieldExpression>
            </textField>

            <textField pattern="##0.00'%'">
                <reportElement x="350" y="0" width="150" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{porcentajeOccupancy} * 100]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- Summary con el promedio final -->
    <summary>
        <band height="30">
            <staticText>
                <reportElement x="0" y="5" width="300" height="20"/>
                <textElement textAlignment="Right">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Promedio de Ocupación Total:]]></text>
            </staticText>

            <textField pattern="##0.00'%'">
                <reportElement x="305" y="5" width="250" height="20"/>
                <textElement textAlignment="Left"/>
                <textFieldExpression><![CDATA[$V{PromedioOcupacion} * 100]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
