<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="ap" prefHeight="602.0" prefWidth="799.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ucr.lab.controller.WaitingQueueController">
   <children>
      <Pane prefHeight="90.0" prefWidth="849.0" style="-fx-background-color: #d4eefa;">
         <children>
            <Label layoutX="126.0" layoutY="30.0" text="Waiting Queue -">
               <font>
                  <Font name="Elephant" size="22.0" />
               </font>
            </Label>
            <Label fx:id="labelAirport" layoutX="315.0" layoutY="32.0" text="Airport">
               <font>
                  <Font name="Elephant" size="22.0" />
               </font>
            </Label>
            <Button fx:id="btBack" layoutX="14.0" layoutY="15.0" mnemonicParsing="false" onAction="#volverAVistaAirportManager" prefHeight="27.0" prefWidth="43.0" text="←">
               <font>
                  <Font size="15.0" />
               </font>
            </Button>
         </children>
      </Pane>
      <Label layoutX="20.0" layoutY="100.0" text="Passengers List:   ">
         <font>
            <Font size="20.0" />
         </font>
      </Label>
      <TextArea fx:id="textAreaPassangers" layoutX="20.0" layoutY="137.0" prefHeight="181.0" prefWidth="716.0" />
      <Button fx:id="btBoardPassengers" layoutX="287.0" layoutY="353.0" mnemonicParsing="false" onAction="#embarcarPasajeros" text="Board Passengers">
         <font>
            <Font size="20.0" />
         </font></Button>
   </children>
</AnchorPane>
