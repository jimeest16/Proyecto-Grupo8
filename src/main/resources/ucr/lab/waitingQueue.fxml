<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="ap" prefHeight="700.0" prefWidth="1033.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ucr.lab.controller.WaitingQueueController">
   <children>
      <Pane prefHeight="90.0" prefWidth="1033.0" style="-fx-background-color: #3498db;">
         <children>
            <Label layoutX="92.0" layoutY="29.0" text="Waiting Queue -" textFill="WHITE">
               <font>
                  <Font name="Segoe UI Black" size="28.0" />
               </font>
            </Label>
            <Label fx:id="labelAirport" layoutX="320.0" layoutY="29.0" text="[Airport Name]" textFill="WHITE">
               <font>
                  <Font name="Segoe UI Black" size="28.0" />
               </font>
            </Label>
            <Button fx:id="btBack" layoutX="25.0" layoutY="25.0" mnemonicParsing="false" onAction="#volverAVistaAirportManager" prefHeight="40.0" prefWidth="40.0" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-background-radius: 5px;" text="←">
               <font>
                  <Font name="Segoe UI Bold" size="18.0" />
               </font>
            </Button>
         </children>
      </Pane>
      <Label layoutX="88.0" layoutY="120.0" text="Passengers List:" textFill="#2c3e50">
         <font>
            <Font name="Segoe UI Bold" size="24.0" />
         </font>
      </Label>
      <TextArea fx:id="textAreaPassangers" editable="false" layoutX="88.0" layoutY="170.0" prefHeight="400.0" prefWidth="857.0" style="-fx-control-inner-background: white; -fx-font-family: 'Consolas'; -fx-font-size: 14px; -fx-border-color: #bdc3c7; -fx-border-radius: 5px;" />
      <Button fx:id="btBoardPassengers" layoutX="400.0" layoutY="600.0" mnemonicParsing="false" onAction="#embarcarPasajeros" prefHeight="50.0" prefWidth="230.0" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-background-radius: 8px;" text="Board Passengers">
         <font>
            <Font name="Segoe UI Bold" size="22.0" />
         </font>
      </Button>
   </children>
</AnchorPane>