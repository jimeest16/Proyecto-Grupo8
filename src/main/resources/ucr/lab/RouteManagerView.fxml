<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.canvas.Canvas?> <AnchorPane prefHeight="650.0" prefWidth="1200.0" style="-fx-background-color: #f7fafd;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ucr.lab.controller.RouteController">
    <VBox spacing="20" style="-fx-padding: 25;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <children>
            <VBox alignment="CENTER" spacing="4">
                <children>
                    <Text fill="#2a6e9a" strokeType="OUTSIDE" strokeWidth="0.0" text="Efficient Route Management">
                        <font>
                            <Font name="Segoe UI Black" size="20.0" />
                        </font>
                    </Text>
                    <Text fill="#5a5a5a" strokeType="OUTSIDE" strokeWidth="0.0" text="Streamline your flight operations by managing routes and connections.">
                        <font>
                            <Font name="Segoe UI Semibold" size="12.0" />
                        </font>
                    </Text>
                </children>
            </VBox>

            <VBox alignment="CENTER" prefWidth="500.0" spacing="12" style="-fx-padding: 15; -fx-background-color: #ffffff; -fx-border-radius: 6; -fx-background-radius: 6; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 4);">
                <children>
                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333333;" text="New Route Information" />

                    <ComboBox fx:id="cmbOrigin" prefWidth="400" promptText="Select Origin Airport" style="-fx-prompt-text-fill: #888888; -fx-background-color: #f0f8ff; -fx-border-color: #b0d9e8; -fx-border-radius: 4; -fx-background-radius: 4;" />
                    <ComboBox fx:id="cmbDestination" prefWidth="400" promptText="Select Destination Airport" style="-fx-prompt-text-fill: #888888; -fx-background-color: #f0f8ff; -fx-border-color: #b0d9e8; -fx-border-radius: 4; -fx-background-radius: 4;" />

                    <TextField fx:id="txtDistance" prefWidth="400" promptText="Enter Distance (in Kilometers or Minutes)" style="-fx-prompt-text-fill: #888888; -fx-background-color: #f0f8ff; -fx-border-color: #b0d9e8; -fx-border-radius: 4; -fx-background-radius: 4;" />

                    <HBox alignment="CENTER" spacing="8">
                        <Button onAction="#addRoute" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 11px; -fx-padding: 6 16; -fx-border-radius: 4; -fx-background-radius: 4;" text="Add Route" />
                        <Button onAction="#modifyRoute" style="-fx-background-color: #FFC107; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 11px; -fx-padding: 6 16; -fx-border-radius: 4; -fx-background-radius: 4;" text="Modify Route" />
                        <Button onAction="#shortestPath" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 11px; -fx-padding: 6 16; -fx-border-radius: 4; -fx-background-radius: 4;" text="Find Shortest Path" />
                        <Button onAction="#clearFields" style="-fx-background-color: #607D8B; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 11px; -fx-padding: 6 16; -fx-border-radius: 4; -fx-background-radius: 4;" text="Clear Fields" />
                        <Button onAction="#generateRandomRoutes" style="-fx-background-color: #17a2b8; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 11px; -fx-padding: 6 16; -fx-border-radius: 4; -fx-background-radius: 4;" text="Generate Random Routes" />
                    </HBox>
                </children>
            </VBox>

            <HBox spacing="20" VBox.vgrow="ALWAYS">
                <children>
                    <VBox spacing="8" style="-fx-padding: 15; -fx-background-color: #ffffff; -fx-border-radius: 6; -fx-background-radius: 6; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 4, 0, 0, 2);" HBox.hgrow="ALWAYS">
                        <children>
                            <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333333;" text="Route information" />
                            <TextArea fx:id="textArea" editable="false" style="-fx-control-inner-background: #f0f0f0; -fx-font-family: 'Consolas'; -fx-font-size: 12px; -fx-text-fill: #333333; -fx-border-color: #d0d0d0; -fx-border-radius: 4; -fx-background-radius: 4;" VBox.vgrow="ALWAYS" />

                            <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333333;" text="Ruta Seleccionada" />
                            <TextArea fx:id="textAreaContent" editable="false" prefHeight="60.0" style="-fx-control-inner-background: #f0f0f0; -fx-font-family: 'Consolas'; -fx-font-size: 12px; -fx-text-fill: #0056b3; -fx-border-color: #d0d0d0; -fx-border-radius: 4; -fx-background-radius: 4;" />
                        </children>
                    </VBox>

                    <VBox spacing="8" style="-fx-padding: 15; -fx-background-color: #ffffff; -fx-border-radius: 6; -fx-background-radius: 6; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 4, 0, 0, 2);" HBox.hgrow="ALWAYS">
                        <children>
                            <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333333;" text="Route visualization" />
                            <Canvas fx:id="graphCanvas" style="-fx-border-color: #d0d0d0; -fx-border-radius: 4; -fx-background-color: #e9eff5;" VBox.vgrow="ALWAYS" />
                            <Button onAction="#drawGraph" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 11px; -fx-padding: 6 16; -fx-border-radius: 4; -fx-background-radius: 4;" text="Dibujar Grafo" />
                        </children>
                    </VBox>
                </children>
            </HBox>
        </children>
    </VBox>
</AnchorPane>