<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: #f7fafd;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ucr.lab.controller.RouteController">
    <VBox spacing="15" style="-fx-padding: 25;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <children>
            <VBox alignment="CENTER" spacing="5">
                <children>
                    <Text fill="#2a6e9a" strokeType="OUTSIDE" strokeWidth="0.0" text="Efficient Route Management">
                        <font>
                            <Font name="Segoe UI Black" size="24.0" />
                        </font>
                    </Text>
                    <Text fill="#5a5a5a" strokeType="OUTSIDE" strokeWidth="0.0" text="Streamline your flight operations by managing routes and connections.">
                        <font>
                            <Font name="Segoe UI Semibold" size="14.0" />
                        </font>
                    </Text>
                </children>
            </VBox>

            <HBox spacing="20" VBox.vgrow="ALWAYS">
                <VBox spacing="12" style="-fx-padding: 20; -fx-background-color: #ffffff; -fx-border-radius: 8; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 4, 0, 0, 1);" HBox.hgrow="ALWAYS">
                    <children>
                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #333333;" text="New Route Information" />
                        <ComboBox fx:id="cmbOrigin" maxWidth="Infinity" prefHeight="35.0" promptText="Select Origin Airport" style="-fx-prompt-text-fill: #888888; -fx-background-color: #f0f8ff; -fx-border-color: #b0d9e8; -fx-border-radius: 5; -fx-background-radius: 5;" />
                        <ComboBox fx:id="cmbDestination" maxWidth="Infinity" prefHeight="35.0" promptText="Select Destination Airport" style="-fx-prompt-text-fill: #888888; -fx-background-color: #f0f8ff; -fx-border-color: #b0d9e8; -fx-border-radius: 5; -fx-background-radius: 5;" />
                        <TextField fx:id="txtDistance" maxWidth="Infinity" prefHeight="35.0" promptText="Enter Distance (in Kilometers or Minutes)" style="-fx-prompt-text-fill: #888888; -fx-background-color: #f0f8ff; -fx-border-color: #b0d9e8; -fx-border-radius: 5; -fx-background-radius: 5;" />

                        <VBox alignment="CENTER" spacing="8" VBox.vgrow="NEVER">
                            <HBox alignment="CENTER" spacing="8">
                                <Button onAction="#addRoute" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 8 20; -fx-border-radius: 5; -fx-background-radius: 5;" text="Add Route" />
                                <Button onAction="#modifyRoute" style="-fx-background-color: #FFC107; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 8 20; -fx-border-radius: 5; -fx-background-radius: 5;" text="Modify Route" />
                            </HBox>
                            <HBox alignment="CENTER" spacing="8">
                                <Button onAction="#shortestPath" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 8 20; -fx-border-radius: 5; -fx-background-radius: 5;" text="Find Shortest Path" />
                                <Button onAction="#clearFields" style="-fx-background-color: #607D8B; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 8 20; -fx-border-radius: 5; -fx-background-radius: 5;" text="Clear Fields" />
                            </HBox>
                            <HBox alignment="CENTER" spacing="8">
                                <Button onAction="#generateRandomRoutes" style="-fx-background-color: #17a2b8; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 8 20; -fx-border-radius: 5; -fx-background-radius: 5;" text="Generate Random Routes" />
                        <Button fx:id="btReport" onAction="#generateReport" style="-fx-background-color: #ed6224; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 8 20; -fx-border-radius: 5; -fx-background-radius: 5;" text="Generate Report" />
                            </HBox>
                        </VBox>

                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #333333; -fx-padding: 20 0 5 0;" text="Route Information Display" />
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                            <content>
                                <VBox alignment="TOP_LEFT" spacing="8">
                                    <TextArea fx:id="textArea" editable="false" prefHeight="250.0" style="-fx-control-inner-background: #f0f0f0; -fx-font-family: 'Consolas'; -fx-font-size: 12px; -fx-text-fill: #333333; -fx-border-color: #d0d0d0; -fx-border-radius: 4; -fx-background-radius: 4;" VBox.vgrow="ALWAYS" />
                                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333333;" text="Selected Route" />
                                    <TextArea fx:id="textAreaContent" editable="false" prefHeight="80.0" style="-fx-control-inner-background: #f0f0f0; -fx-font-family: 'Consolas'; -fx-font-size: 12px; -fx-text-fill: #0056b3; -fx-border-color: #d0d0d0; -fx-border-radius: 4; -fx-background-radius: 4;" />
                                </VBox>
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>

                <VBox spacing="10" style="-fx-padding: 20; -fx-background-color: #ffffff; -fx-border-radius: 8; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 4, 0, 0, 1);" HBox.hgrow="ALWAYS">
                    <children>
                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #333333;" text="Route Visualization" />
                        <Canvas fx:id="graphCanvas" style="-fx-border-color: #d0d0d0; -fx-border-radius: 4; -fx-background-color: #e9eff5;" VBox.vgrow="ALWAYS" />
                        <Button onAction="#drawGraph" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 8 20; -fx-border-radius: 5; -fx-background-radius: 5;" text="Draw Graph" />
                    </children>
                </VBox>
            </HBox>
        </children>
    </VBox>
</AnchorPane>
