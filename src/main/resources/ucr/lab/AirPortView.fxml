<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="650.0" prefWidth="900.0" style="-fx-background-color: #f3f8fb;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ucr.lab.controller.AirPortController">
   <VBox prefHeight="650.0" prefWidth="900.0" spacing="20" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
      <padding>
         <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
      </padding>
      <children>
         <VBox alignment="CENTER" spacing="6">
            <children>
               <Text fill="#2a6e9a" strokeType="OUTSIDE" strokeWidth="0.0" text="Airport Management">
                  <font>
                     <Font name="Segoe UI Black" size="30.0" />
                  </font>
               </Text>
               <Text fill="#5a5a5a" strokeType="OUTSIDE" strokeWidth="0.0" text="Manage airports for an unforgettable flight experience!">
                  <font>
                     <Font name="Segoe UI Semibold" size="16.0" />
                  </font>
               </Text>
            </children>
         </VBox>

         <HBox alignment="CENTER" spacing="25" style="-fx-background-color: #ffffff; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 6);">
            <padding>
               <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <children>
               <Button fx:id="btCrear" onAction="#createAirport" prefHeight="32.0" prefWidth="160.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 6 20; -fx-border-radius: 6; -fx-background-radius: 6; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 3, 0, 0, 1);" text="Create Airport">
                  <font>
                     <Font size="13.0" />
                  </font>
               </Button>
               <Button fx:id="btCrear2" onAction="#updateAirport" prefHeight="32.0" prefWidth="180.0" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 6 20; -fx-border-radius: 6; -fx-background-radius: 6; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 3, 0, 0, 1);" text="Modify Airport">
                  <font>
                     <Font size="13.0" />
                  </font>
               </Button>
               <Button fx:id="btCrear1" onAction="#onGenerarReporteClick" prefHeight="32.0" prefWidth="180.0" style="-fx-background-color: #607D8B; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 6 20; -fx-border-radius: 6; -fx-background-radius: 6; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 3, 0, 0, 1);" text="Generate Report">
                  <font>
                     <Font size="13.0" />
                  </font>
               </Button>
            </children>
         </HBox>

         <HBox alignment="TOP_CENTER" spacing="20" VBox.vgrow="ALWAYS">
            <VBox prefHeight="350.0" prefWidth="350.0" spacing="15" style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 6, 0, 0, 3);" HBox.hgrow="ALWAYS">
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
               <children>
                  <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #333333;" text="Airport information" />
                  <GridPane hgap="10" vgap="10">
                     <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="200.0" />
                     </columnConstraints>
                     <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="28.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="28.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="28.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="28.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="28.0" vgrow="SOMETIMES" />
                     </rowConstraints>
                     <children>
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #666666;" text="Airport ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <TextField fx:id="tfID" promptText="Ex: 1001" style="-fx-font-size: 13px; -fx-background-color: #f0f8ff; -fx-border-color: #b0d9e8; -fx-border-radius: 5; -fx-background-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <Label style="-fx-font-size: 14px; -fx-text-fill: #666666;" text="Name:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <TextField fx:id="tfNombre" promptText="Ex: Juan Santamaría Intl." style="-fx-font-size: 13px; -fx-background-color: #f0f8ff; -fx-border-color: #b0d9e8; -fx-border-radius: 5; -fx-background-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label style="-fx-font-size: 14px; -fx-text-fill: #666666;" text="Country:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <TextField fx:id="tfPais" promptText="Ex: Costa Rica" style="-fx-font-size: 13px; -fx-background-color: #f0f8ff; -fx-border-color: #b0d9e8; -fx-border-radius: 5; -fx-background-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                        <Label style="-fx-font-size: 14px; -fx-text-fill: #666666;" text="Status:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                        <ComboBox fx:id="mEstado" prefWidth="210.0" promptText="Select State" style="-fx-font-size: 13px; -fx-background-color: #f0f8ff; -fx-border-color: #b0d9e8; -fx-border-radius: 5; -fx-background-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                        <Label style="-fx-font-size: 14px; -fx-text-fill: #666666;" text="Departures:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                        <ComboBox fx:id="mSalidas" prefWidth="210.0" promptText="Select Departure" style="-fx-font-size: 13px; -fx-background-color: #f0f8ff; -fx-border-color: #b0d9e8; -fx-border-radius: 5; -fx-background-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                     </children>
                  </GridPane>
               </children>
            </VBox>

            <VBox prefHeight="350.0" prefWidth="500.0" spacing="10" style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 6, 0, 0, 3);" HBox.hgrow="ALWAYS">
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="15">
                     <children>
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #333333;" text="Registered Airports" />
                        <HBox alignment="CENTER_RIGHT" spacing="8" HBox.hgrow="ALWAYS">
                           <children>
                              <RadioButton fx:id="rbActivos" text="Active">
                                 <toggleGroup>
                                    <ToggleGroup fx:id="airportFilterGroup" />
                                 </toggleGroup>
                                 <font>
                                    <Font name="Segoe UI Regular" size="13.0" />
                                 </font>
                              </RadioButton>
                              <RadioButton fx:id="rbInactivos" text="Inactive" toggleGroup="$airportFilterGroup">
                                 <font>
                                    <Font name="Segoe UI Regular" size="13.0" />
                                 </font>
                              </RadioButton>
                           </children>
                        </HBox>
                     </children>
                  </HBox>
                  <TableView fx:id="tvAirports" prefHeight="270.0" prefWidth="450.0" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="cID" prefWidth="60.0" text="ID" />
                        <TableColumn fx:id="cNombre" prefWidth="100.0" text="Name" />
                        <TableColumn fx:id="cPais" prefWidth="90.0" text="Country" />
                        <TableColumn fx:id="cEstado" minWidth="0.0" prefWidth="100.0" text="Status" />
                        <TableColumn fx:id="cRegistro" minWidth="0.0" prefWidth="140.0" text="Departure Board" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
            </VBox>
         </HBox>
      </children>
   </VBox>
</AnchorPane>
