<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<TabPane fx:id="tabPaneMain" prefHeight="580.0" prefWidth="850.0" style="-fx-background-color: #f0f8ff;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ucr.lab.controller.UserController">

    <Tab closable="false" style="-fx-background-color: #d8e6f0;" text="Flight Tickets &amp; Boarding">
        <content>
            <VBox spacing="20.0" style="-fx-background-color: #f7fafd; -fx-padding: 30 40;">

                <VBox alignment="CENTER" spacing="8" style="-fx-padding: 15; -fx-background-color: #ffffff; -fx-border-radius: 10; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 6);">
                    <children>
                        <ImageView fitHeight="60.0" fitWidth="60.0" preserveRatio="true">
                            <image>
                                <Image url="@ticket.png" /> </image>
                        </ImageView>
                        <Text fill="#2a6e9a" strokeType="OUTSIDE" strokeWidth="0.0" text="Flight Tickets &amp; Boarding Simulation">
                            <font>
                                <Font name="Elephant" size="30.0" />
                            </font>
                        </Text>
                    </children>
                </VBox>

                <VBox spacing="10.0" style="-fx-padding: 15; -fx-background-color: #ffffff; -fx-border-radius: 10; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 4);">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #333333;" text="Buscar Vuelos Disponibles" />
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                            <Label style="-fx-font-size: 13px; -fx-text-fill: #555555;" prefHeight="17.0" prefWidth="70.0" text="Origen " />
                            <ComboBox fx:id="cbSearchOriginCode" prefWidth="130.0" promptText="Seleccionar" style="-fx-background-color: #f0f8ff; -fx-border-color: #b0d9e8; -fx-border-radius: 4; -fx-background-radius: 4;" />
                            <Label style="-fx-font-size: 13px; -fx-text-fill: #555555;" text="Destino " />
                            <ComboBox fx:id="cbSearchDestinationCode" prefWidth="130.0" promptText="Seleccionar" style="-fx-background-color: #f0f8ff; -fx-border-color: #b0d9e8; -fx-border-radius: 4; -fx-background-radius: 4;" />
                            <Button onAction="#handleSearchFlights" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 6 15; -fx-border-radius: 4; -fx-background-radius: 4; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 3, 0, 0, 1);" text="Buscar Vuelos" />
                        </HBox>
                    </children>
                </VBox>

                <VBox spacing="8.0" style="-fx-padding: 15; -fx-background-color: #ffffff; -fx-border-radius: 10; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 4);">
                    <children>
                        <TableView fx:id="tvAvailableFlights" prefHeight="180.0" prefWidth="750.0" style="-fx-border-color: #e0f2f7; -fx-border-radius: 6; -fx-background-radius: 6;">
                            <columns>
                                <TableColumn fx:id="colFlightNumber" prefWidth="70.0" text="Vuelo" />
                                <TableColumn fx:id="colOriginCode" prefWidth="70.0" text="Origen" />
                                <TableColumn fx:id="colDestinationCode" prefWidth="70.0" text="Destino" />
                                <TableColumn fx:id="colDepartureTime" prefWidth="110.0" text="Hora Salida" />
                                <TableColumn fx:id="colCapacity" prefWidth="60.0" text="Capacidad" />
                                <TableColumn fx:id="colOccupancy" prefWidth="70.0" text="Ocupación" />
                                <TableColumn fx:id="colFlightStatus" prefWidth="90.0" text="Estado" />
                                <TableColumn fx:id="colRoute" prefWidth="110.0" text="Ruta" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>

                <VBox spacing="10.0" style="-fx-padding: 15; -fx-background-color: #ffffff; -fx-border-radius: 10; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 4);">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #333333;" text="Acciones de Pasajero" />
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                            <Label style="-fx-font-size: 13px; -fx-text-fill: #555555;" text="ID Pasajero:" />
                            <TextField fx:id="txtPassengerIdForTicket" prefWidth="150.0" promptText="Ingrese ID Pasajero" style="-fx-background-color: #f0f8ff; -fx-border-color: #b0d9e8; -fx-border-radius: 4; -fx-background-radius: 4;" />
                            <Button onAction="#handleBuyTicket" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 6 15; -fx-border-radius: 4; -fx-background-radius: 4; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 3, 0, 0, 1);" text="Comprar Tiquete para Vuelo Seleccionado" />
                            <Button onAction="#handleBoardPassenger" style="-fx-background-color: #FFC107; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 6 15; -fx-border-radius: 4; -fx-background-radius: 4; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 3, 0, 0, 1);" text="Embarcar Pasajero en Vuelo Seleccionado" />
                        </HBox>
                    </children>
                </VBox>

                <VBox spacing="8.0" style="-fx-padding: 15; -fx-background-color: #ffffff; -fx-border-radius: 10; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 4);">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #333333;" text="Messages &amp; Output" />
                        <TextArea fx:id="txtUserOutput" editable="false" prefHeight="70.0" prefWidth="750.0" wrapText="true" style="-fx-control-inner-background: #f0f0f0; -fx-font-family: 'Consolas'; -fx-font-size: 12px; -fx-text-fill: #333333; -fx-border-color: #d0d0d0; -fx-border-radius: 4; -fx-background-radius: 4;" />
                    </children>
                </VBox>

            </VBox>
        </content>
    </Tab>

</TabPane>