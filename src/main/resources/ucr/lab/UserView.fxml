<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<TabPane fx:id="tabPaneMain" prefHeight="593.0" prefWidth="886.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ucr.lab.controller.UserController">

    <Tab closable="false" style="-fx-background-color: #d2d4d6;" text="Flight Tickets &amp; Boarding">
        <content>
            <VBox prefHeight="564.0" prefWidth="853.0" spacing="15.0" style="-fx-background-color: #ebedee;">
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                </padding>

                <Pane prefHeight="70.0" prefWidth="760.0">
                    <children>
                        <Text fill="#548bc1" layoutX="93.0" layoutY="33.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Flight Tickets &amp; Boarding Simulation">
                            <font>
                                <Font name="Elephant" size="31.0" />
                            </font>
                        </Text>
                    </children>
                </Pane>

                <Pane prefHeight="70.0" prefWidth="849.0">
                    <children>
                        <VBox layoutX="14.0" layoutY="3.0" prefHeight="60.0" prefWidth="847.0" spacing="10.0">
                            <Label style="-fx-font-weight: bold; -fx-font-size: 16px;" text="Buscar Vuelos Disponibles" />
                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <Label prefHeight="17.0" prefWidth="84.0" text="Origen " />
                                <Label />
                                <ComboBox fx:id="cbSearchOriginCode" prefWidth="100.0" promptText="Seleccionar" />
                                <Label text="Destino " />
                                <ComboBox fx:id="cbSearchDestinationCode" prefWidth="100.0" promptText="Seleccionar" /> <Label text="Fecha:" />
                                <DatePicker fx:id="dpSearchDepartureDate" prefWidth="150.0" promptText="Seleccionar Fecha" />
                                <Button onAction="#handleSearchFlights" style="-fx-background-color: #82baf3; -fx-text-fill: white;" text="Buscar Vuelos" />
                            </HBox>
                        </VBox>
                    </children>
                </Pane>

                <Pane prefHeight="260.0" prefWidth="849.0">
                    <children>
                        <TableView fx:id="tvAvailableFlights" layoutX="43.0" layoutY="9.0" prefHeight="241.0" prefWidth="760.0">
                            <columns>
                                <TableColumn fx:id="colFlightNumber" prefWidth="90.0" text="Vuelo" />
                                <TableColumn fx:id="colOriginCode" prefWidth="80.0" text="Origen" />
                                <TableColumn fx:id="colDestinationCode" prefWidth="80.0" text="Destino" />
                                <TableColumn fx:id="colDepartureTime" prefWidth="130.0" text="Hora Salida" />
                                <TableColumn fx:id="colCapacity" prefWidth="70.0" text="Capacidad" />
                                <TableColumn fx:id="colOccupancy" prefWidth="80.0" text="Ocupación" />
                                <TableColumn fx:id="colFlightStatus" prefWidth="100.0" text="Estado" />
                                <TableColumn fx:id="colRoute" prefWidth="130.0" text="Ruta" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </Pane>

                <Pane prefHeight="70.0" prefWidth="760.0">
                    <children>
                        <VBox layoutX="0.0" layoutY="0.0" spacing="10.0">
                            <Label style="-fx-font-weight: bold; -fx-font-size: 16px;" text="Acciones de Pasajero" />
                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <Label text="ID Pasajero:" />
                                <TextField fx:id="txtPassengerIdForTicket" prefWidth="150.0" promptText="Ingrese ID Pasajero" />
                                <Button onAction="#handleBuyTicket" style="-fx-background-color: #5cb85c; -fx-text-fill: white;" text="Comprar Tiquete para Vuelo Seleccionado" />
                                <Button onAction="#handleBoardPassenger" style="-fx-background-color: #f0ad4e; -fx-text-fill: white;" text="Embarcar Pasajero en Vuelo Seleccionado" />
                            </HBox>
                        </VBox>
                    </children>
                </Pane>

                <Pane prefHeight="110.0" prefWidth="760.0">
                    <children>
                        <TextArea fx:id="txtUserOutput" editable="false" prefHeight="100.0" prefWidth="760.0" wrapText="true" />
                    </children>
                </Pane>

            </VBox>
        </content>
    </Tab>

</TabPane>
